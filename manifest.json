{
    "manifest_version": 3,
    "name": "Jira Diff Highlighter (Server / Data Center)",
    "version": "1.0.0",
    "description": "Readable, colour-coded diffs for Description and other text fields on the History tab of on-premise Jira (Server / Data Center).",
    "permissions": [
        "storage",
        "scripting",
        "activeTab"
    ],
    "optional_host_permissions": [
        "*://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Jira Diff Highlighter",
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
